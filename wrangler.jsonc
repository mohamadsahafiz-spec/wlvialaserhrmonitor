{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "laser-management-system",
  "main": "src/worker.js",
  "compatibility_date": "2024-09-25",
  "assets": {
    "directory": "."
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lms_db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
